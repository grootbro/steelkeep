user default off
user fixture_admin on >local-redis-admin-only ~* &* +@all
user backup_reader on >local-redis-reader-only ~* &* -@all +auth +hello +ping +select +client|info +client|setinfo +client|setname +info +time +dbsize +scan +type +memory|usage +dump +pexpiretime +eval_ro
user restore_writer on >local-redis-writer-only ~* &* -@all +auth +hello +ping +select +client|info +client|setinfo +client|setname +info +time +dbsize +scan +type +memory|usage +dump +pexpiretime +eval_ro +restore
