# Isolated development fixtures only. Generate a real local key with scripts/setup-local.ts.
DATABASE_URL=postgres://steelkeep:local-metadata-only@127.0.0.1:54371/steelkeep
STEELKEEP_KEY_FILE=.steelkeep/key
STEELKEEP_TOKEN_FILE=.steelkeep/token
STEELKEEP_ALLOWED_HOSTS=127.0.0.1,localhost,fixture,mysql-fixture,s3
STEELKEEP_ALLOWED_ORIGINS=http://127.0.0.1:4310,http://localhost:4310
PORT=4311
# Explicit worker-local SQLite mounts. Empty means SQLite file admission is disabled.
STEELKEEP_SQLITE_SOURCE_ROOTS=
STEELKEEP_SQLITE_TARGET_ROOTS=
# ClickHouse backup disks must also be mounted at the same path in the worker.
STEELKEEP_CLICKHOUSE_BACKUP_ROOTS=
# Optional provisioned Linux x64 .NET helper. Never put credentials in this value.
STEELKEEP_DACFX_HELPER=
