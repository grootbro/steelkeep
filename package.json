{
  "name": "steelkeep",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4310",
    "dev:api": "bun --watch server/index.ts",
    "worker": "bun server/worker.ts",
    "build": "vite build",
    "start": "bun server/serve.ts",
    "setup:local": "bun scripts/setup-local.ts",
    "setup:owner": "bun scripts/setup-owner.ts",
    "seed:fixture": "bun scripts/seed-fixture.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:acceptance": "tsc --noEmit --project tsconfig.acceptance.json",
    "test": "bun test tests/security.test.ts tests/resources.test.ts tests/pending-backups.test.ts tests/pending-restores.test.ts tests/appearance.test.ts tests/artifact-comments.test.ts tests/connection-history.test.ts tests/dashboard-data.test.ts tests/history.test.ts tests/history-dates.test.ts tests/mssql-helper.test.ts tests/mssql-continuation.test.ts tests/notification-requests.test.ts tests/retention-requests.test.ts tests/retention.test.ts tests/notifications.test.ts tests/manifest.test.ts tests/mongodb-lock-state.test.ts tests/sql-grants.test.ts tests/storage-errors.test.ts tests/owner-auth.test.ts tests/setup-owner.test.ts tests/auth-destination.test.ts",
    "test:integration": "STEELKEEP_ACCEPTANCE=synthetic-local bun test tests/api.integration.test.ts tests/connections.integration.test.ts tests/artifact-availability.integration.test.ts",
    "infra:up": "docker compose up -d --wait",
    "db:migrate": "bun server/migrate.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@aws-sdk/client-s3": "3.1160.0",
    "@elysia/eden": "1.4.10",
    "@elysia/openapi": "1.4.16",
    "@modelcontextprotocol/server": "2.4.0",
    "@scalar/api-reference": "1.76.4",
    "@tanstack/query-db-collection": "1.5.0",
    "@tanstack/react-db": "1.0.0-rc.1",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "cron-parser": "5.4.0",
    "elysia": "1.4.30",
    "kysely": "0.29.2",
    "lucide-react": "0.468.0",
    "mysql2": "3.24.6",
    "mongodb": "7.8.0",
    "mssql": "12.7.13",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/node": "^24.0.0",
    "@types/mssql": "12.3.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
